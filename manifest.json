{\n  "manifest_version": 3,\n  "name": "Explain UI - AI-Powered Element Explainer",\n  "version": "1.0.0",\n  "description": "Hover over any UI element to get instant AI-powered explanations. Perfect for beginners!",\n  "permissions": ["scripting", "storage"],\n  "host_permissions": ["<all_urls>"],\n  "action": {\n    "default_popup": "public/popup.html",\n    "default_title": "Explain UI Settings"\n  },\n  "background": {\n    "service_worker": "src/background.js"\n  },\n  "content_scripts": [\n    {\n      "matches": ["<all_urls>"],\n      "js": ["src/content.js"],\n      "css": ["public/styles.css"],\n      "run_at": "document_start"\n    }\n  ],\n  "icons": {\n    "16": "public/icons/icon16.png",\n    "48": "public/icons/icon48.png",\n    "128": "public/icons/icon128.png"\n  }\n}